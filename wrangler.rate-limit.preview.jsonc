{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itransfer-rate-limit-preview",
  "main": "rate-limit-worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "ratelimits": [
    { "name": "UPLOAD_LIMIT", "namespace_id": "910101", "simple": { "limit": 30, "period": 60 } },
    { "name": "PARTS_LIMIT", "namespace_id": "910102", "simple": { "limit": 120, "period": 60 } },
    { "name": "DOWNLOAD_LIMIT", "namespace_id": "910103", "simple": { "limit": 120, "period": 60 } },
    // Kept so a script-only rollback to the previous worker still has this native binding. The current script does not call it.
    { "name": "PASSWORD_LIMIT", "namespace_id": "910104", "simple": { "limit": 8, "period": 60 } },
    { "name": "CLAIM_LIMIT", "namespace_id": "910105", "simple": { "limit": 20, "period": 60 } },
    { "name": "DELETE_LIMIT", "namespace_id": "910106", "simple": { "limit": 20, "period": 60 } },
    { "name": "REQUEST_LIMIT", "namespace_id": "910107", "simple": { "limit": 10, "period": 60 } },
    { "name": "EMAIL_LIMIT", "namespace_id": "910108", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PASSWORD_LIMIT_DO", "class_name": "PasswordRateLimit" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-password-strict",
      "new_sqlite_classes": ["PasswordRateLimit"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
