# ==========================================
# iTransfer — Backend Environment Variables
# ==========================================

# 1. Cloudflare R2 (10 GB Free Tier + 0 Egress Costs)
# Obtain from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=itransfer-storage

# 2. PostgreSQL Database (Prisma ORM)
# Can use Supabase, Neon, or Railway PostgreSQL connection pooler
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itransfer?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/itransfer?schema=public"

# 3. Redis Cache (Sub-millisecond link redirection)
# Obtain from Upstash Redis or self-hosted Redis
REDIS_URL="redis://localhost:6379"

# 4. Supabase Client (Frontend & Storage Backup)
VITE_SUPABASE_URL=https://giyeepztahdbsejsozog.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XenT3T8l2M0-SWsHDJZpUg_3elJqmVU

# 5. Dodo Payments (server only — leave checkout disabled until a real product and paid limit exist)
# Test mode is the default. Set DODO_ENV=live only for a reviewed live key.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=
DODO_CHECKOUT_ENABLED=
DODO_ENV=
