{
  "name": "cloudwarden-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:isolated": "ITRANSFER_ISOLATED=1 vite",
    "supabase:isolated:start": "sh supabase/testing/local-stack/start-isolated.sh",
    "supabase:isolated:status": "supabase --workdir supabase/testing/local-stack status",
    "supabase:isolated:stop": "sh supabase/testing/local-stack/start-isolated.sh stop",
    "supabase:restore-lab:start": "sh supabase/testing/restore-lab/start-restore-lab.sh",
    "supabase:restore-lab:status": "sh supabase/testing/restore-lab/start-restore-lab.sh status",
    "supabase:restore-lab:stop": "sh supabase/testing/restore-lab/start-restore-lab.sh stop",
    "supabase:restore-lab:restore": "sh supabase/testing/restore-lab/restore-backup.sh",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@google-cloud/storage": "^8.0.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "ioredis": "^6.0.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "nodemailer": "^9.0.5",
    "peerjs": "^1.5.5",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-router-dom": "^7.18.2",
    "suncalc": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "8.2.4",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2",
    "vite": "8.2.4"
  }
}
