# Cloudflare Edge Cache & Security Rules

# Immutable cache for versioned assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Immutable cache for static images & flags
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# High-priority SEO files
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# User Dashboard — Allowed to crawl so search engines read and enforce the noindex directive
/transfers
  X-Robots-Tag: noindex, nofollow, noarchive

